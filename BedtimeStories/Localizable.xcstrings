      }
    },
    "Continuing lets the app store your books in its iCloud folder when iCloud Drive is available. Manage family sharing in Files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuing lets the app store your books in its iCloud folder when iCloud Drive is available. Manage family sharing in Files."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuując, pozwalasz aplikacji zapisywać książki w jej folderze iCloud, gdy iCloud Drive jest dostępny. Udostępnianiem rodzinie zarządzasz w aplikacji Pliki."
          }
        }
      }
    },
    "The app uses its default library automatically. Open Files to manage its books and sharing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app uses its default library automatically. Open Files to manage its books and sharing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja automatycznie korzysta ze swojego folderu biblioteki. Książkami i udostępnianiem zarządzasz w aplikacji Pliki."
          }
        }
      }
    },
    "iCloud syncs books across your devices using the same Apple Account. Family members need an invitation to a shared folder in Files. Sharing does not automatically connect their app libraries; they can import a shared .bedtimestory file. Reading and listening positions stay on each device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud syncs books across your devices using the same Apple Account. Family members need an invitation to a shared folder in Files. Sharing does not automatically connect their app libraries; they can import a shared .bedtimestory file. Reading and listening positions stay on each device."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud synchronizuje książki między Twoimi urządzeniami korzystającymi z tego samego konta Apple. Rodzinę zapraszasz do udostępnionego folderu w aplikacji Pliki. Nie łączy to automatycznie bibliotek w aplikacji — bliscy mogą zaimportować udostępniony plik .bedtimestory. Miejsce czytania i słuchania jest zapisywane osobno na każdym urządzeniu."
          }
        }
      }
    },
    "Books are stored on this device. Turn on iCloud Drive in Settings to sync them across your devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books are stored on this device. Turn on iCloud Drive in Settings to sync them across your devices."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Książki są zapisane na tym urządzeniu. Włącz iCloud Drive w Ustawieniach, aby synchronizować je między urządzeniami."
          }
        }
      }
    },
