    "Add book folders in Files or import a .bedtimestory book. A title is all a book needs to begin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add book folders in Files or import a .bedtimestory book. A title is all a book needs to begin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj foldery książek w aplikacji Pliki lub zaimportuj plik .bedtimestory. Na początek wystarczy sam tytuł."
          }
        }
      }
    },
    "Add book folders with text, pictures, or audio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
