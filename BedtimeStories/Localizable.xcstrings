    "Your library has a home. We’ll use Always Near Stories in iCloud Drive and create it if needed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library has a home. We’ll use Always Near Stories in iCloud Drive and create it if needed."
