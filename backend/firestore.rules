rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'apple.com';
    }
    function active(uid) {
      return !exists(/databases/$(database)/documents/privateAccounts/$(uid))
        || get(/databases/$(database)/documents/privateAccounts/$(uid)).data.state == 'active';
    }
    match /users/{uid}/voices/{profileId} {
      allow get, list: if owner(uid) && active(uid);
      allow write: if false;
    }
    match /users/{uid}/jobs/{jobId} {
      allow get, list: if owner(uid) && active(uid);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
